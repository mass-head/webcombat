# TravelGuard AI -- example environment variables (Phase 1)
# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file with secrets.
SECRET_KEY=change-me-to-a-long-random-value
FLASK_ENV=development
FLASK_PORT=5000
# SQLite database URL (relative to backend/app.py). Default used if unset.
DATABASE_URL=sqlite:///../instance/travelguard.db
# Comma-separated list of trusted frontend origins for CORS.
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Gemini API Key for AI Travel Assistant (Phase 5).
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Google Places API Key for Emergency Assistance (Phase 6).
# Get yours at: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Geocoding API
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
# Weather API Key for Route Planning (Phase 7).
# Get yours at: https://openweathermap.org/api (or other provider)
OPENWEATHER_API_KEY=your-openweather-api-key-here
